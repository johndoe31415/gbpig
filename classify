import os
import sys
import json
from FriendlyArgumentParser import FriendlyArgumentParser
from Tools import ImageTools

parser = FriendlyArgumentParser(description = "Classify a photo to be used as a passport.")
parser.add_argument("-v", "--verbose", action = "count", default = 0, help = "Increases verbosity. Can be specified multiple times to increase.")
parser.add_argument("image_input_filename", help = "Image input file.")
parser.add_argument("json_output_filename", nargs = "?", help = "Classified output file. Choosen automatically if omitted.")
args = parser.parse_args(sys.argv[1:])

if args.json_output_filename is not None:
	json_output_filename = args.json_output_filename
else:
	json_output_filename = os.path.splitext(args.image_input_filename)[0] + ".json"

if os.path.exists(json_output_filename):
	raise FileExistsError(f"Refusing to overwrite: {json_output_filename}")

def get_coordinates(prompt):
	while True:
		value = input(prompt)
		value = value.split(",")
		return (int(value[0]), int(value[1]))

def get_value(prompt):
	while True:
		value = input(prompt)
		value = int(value)
		return value

def get_person_type(prompt: str):
	while True:
		value = input(prompt)
		if value.lower() in [ "a", "c" ]:
			return {
				"a":	"adult",
				"c":	"child",
			}[value]

person_type = get_coordinates("Adult (a) or child(c)       : ")
left_eye = get_coordinates("Left eye coordinates (x, y) : ")
right_eye = get_coordinates("Right eye coordinates (x, y): ")
nose = get_coordinates("Nose coordinates (x, y)     : ")
head_y = get_value("Head Y value                : ")
chin_y = get_value("Chin Y value                : ")

json_data = {
	"image": {
		"filename":		args.image_input_filename,
		"geometry":		ImageTools.get_image_geometry(args.image_input_filename),
		"person_type":	person_type,
	},
	"pois": {
		"left_eye":		left_eye,
		"right_eye":	right_eye,
		"head_y":		head_y,
		"chin_y":		chin_y,
		"nose":			nose,
	},
}

with open(json_output_filename, "w") as f:
	json.dump(json_data, f, sort_keys = True, indent = "\t")
